generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   // 'mahasiswa' or 'umkm'
  balance   Float    @default(0)
  kycStatus String   @default("UNVERIFIED") // 'UNVERIFIED', 'PENDING', 'VERIFIED'
  ktpImageUrl String?
  createdAt DateTime @default(now())

  // Relations
  jobs         Job[]         @relation("UmkmJobs")
  applications Application[] @relation("MahasiswaApplications")
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  transactions     Transaction[]
}

model Job {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  salary      String?
  location    String?
  type        String?  // 'Part-time', 'Freelance', 'Full-time'
  imageUrl    String?
  status      String   @default("open") // 'open', 'closed'
  createdAt   DateTime @default(now())

  // Relations
  umkmId       Int
  umkm         User          @relation("UmkmJobs", fields: [umkmId], references: [id])
  applications Application[]
}

model Application {
  id            Int      @id @default(autoincrement())
  status        String   @default("menunggu") // 'menunggu', 'diterima', 'ditolak'
  submissionUrl String?  // Untuk tipe kerja Sayembara (Link ke karya yang diberi watermark)
  coverLetter   String?  // Untuk tipe kerja Part-Time
  createdAt     DateTime @default(now())

  // Relations
  jobId       Int
  job         Job      @relation(fields: [jobId], references: [id])
  mahasiswaId Int
  mahasiswa   User     @relation("MahasiswaApplications", fields: [mahasiswaId], references: [id])

  @@unique([jobId, mahasiswaId])
}

model Message {
  id         Int      @id @default(autoincrement())
  text       String
  createdAt  DateTime @default(now())

  senderId   Int
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId Int
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

model Transaction {
  id          Int      @id @default(autoincrement())
  userId      Int
  amount      Float
  type        String   // 'Masuk', 'Keluar'
  description String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}
